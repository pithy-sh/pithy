{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!**/*.generated.ts"] },
  // Gate 1 of the route request contract. Scoped to the HTTP layer of the capability packages: those
  // are the routes Pithy provides, and the only place `c.req.valid()` is guaranteed to be available.
  // An adopter's own handlers are theirs — we specify the pattern, we don't police their code.
  //
  // The second glob reaches a seam that nests its own HTTP layer one level deeper —
  // `packages/core/src/controlPlane/http/**`. Without it the `control-plane` routes, which are the
  // highest-risk routes Pithy ships, would have been the only ones where `c.req.json(` stayed legal.
  "plugins": [
    {
      "path": "plugins/no-raw-request-input.grit",
      "includes": ["**/packages/*/src/http/**", "**/packages/*/src/*/http/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":URL:", ":NODE:"]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "quoteStyle": "double"
    },
    "linter": {
      "enabled": true
    }
  }
}
