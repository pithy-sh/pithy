{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!**/*.generated.ts"] },
  // Gate 1 of the route request contract. Scoped to the HTTP layer of the capability packages: those
  // are the routes Pithy provides, and the only place `c.req.valid()` is guaranteed to be available.
  // An adopter's own handlers are theirs — we specify the pattern, we don't police their code.
  //
  // The second glob reaches a seam that nests its own HTTP layer one level deeper —
  // `packages/core/src/controlPlane/http/**`. Without it the `control-plane` routes, which are the
  // highest-risk routes Pithy ships, would have been the only ones where `c.req.json(` stayed legal.
  //
  // Gate for structured logging. Scoped to the runtime source Pithy itself ships, and no further:
  // `scripts/` are build-time tools whose whole job is terminal output, and an adopter's Worker is
  // theirs to log from however they like.
  //
  // The two logger adapters are excluded because they are the thing console is banned in favour of —
  // `logger/local.ts` sinks to `console.error` and `logger/worker.ts` emits through `console.log`,
  // which is how a record reaches Workers Logs at all. Tests and `test-utils/` are excluded because a
  // test harness printing debris it is reaping is output for a human at a terminal, not a log line.
  //
  // `payments/src/client/paddleCache.ts` is excluded for a third reason: it compiles into an adopter's
  // *browser* bundle, where there is no request context to resolve `c.var.log` from and no Workers Logs
  // for a record to reach. `console` is the sink an adopter reads there, and the one line it writes is a
  // misconfigured cache — a mistake the person reading that console is the only one who can fix. The
  // rest of `src/client/**` stays gated: this is the one module that may say anything at all.
  //
  // `no-process-io.grit` is the same gate for `process.stdout`/`process.stderr`, and it needs its own
  // entry rather than two more patterns in the one above, because it needs the opposite scope: the CLI
  // is the one package where writing to stdout is correct, since that is how a CLI emits and `--json`
  // on stdout is a contract every command owes. There is nothing to fix outside it — the gate is free
  // while the count is zero, which is the cheapest moment to add it.
  "plugins": [
    {
      "path": "plugins/no-raw-request-input.grit",
      "includes": ["**/packages/*/src/http/**", "**/packages/*/src/*/http/**"]
    },
    {
      "path": "plugins/no-console.grit",
      "includes": [
        "**/packages/*/src/**",
        "!**/packages/core/src/logger/local.ts",
        "!**/packages/core/src/logger/worker.ts",
        "!**/packages/payments/src/client/paddleCache.ts",
        "!**/*.test.ts",
        "!**/test-utils/**"
      ]
    },
    {
      "path": "plugins/no-process-io.grit",
      "includes": ["**/packages/*/src/**", "!**/packages/cli/**", "!**/*.test.ts", "!**/test-utils/**"]
    },
    // `no-z-config.grit` refuses Zod's global error map. It is the widest scope of the four and takes
    // no exclusion at all — not even for tests — because the failure it prevents is a Worker isolate
    // outliving one request and carrying that request's locale into the next one's parse (#441). A test
    // that sets the global poisons every file sharing its worker, which is the same defect wearing a
    // flake's clothes. Note the shape the two entries above live with: `"!**/*.test.ts"` does not
    // exclude a `.tsx`, so an exclusion list here would have been a hole rather than a scope.
    {
      "path": "plugins/no-z-config.grit",
      "includes": ["**/packages/*/src/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":URL:", ":NODE:"]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "quoteStyle": "double"
    },
    "linter": {
      "enabled": true
    }
  }
}
