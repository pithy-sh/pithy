{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  // Biome for both lint and format — one tool, one pass, no ESLint/Prettier pair to keep in step.
  // `bun run lint` reports; `bun run format` writes.
  //
  // No `vcs` block on purpose. Reading .gitignore needs a repository, and `pithy init` scaffolds into
  // directories that are not one yet — the ignores are stated here instead, so the first `bun run lint`
  // works before the first `git init`. `openapi.json` and `asyncapi.json` are `pithy contract`'s
  // output: generated, rewritten whenever a route or a frame changes, and never formatted by hand.
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/.wrangler", "!**/.worktrees", "!**/openapi.json", "!**/asyncapi.json"]
  },
  // The kit's six lint safeguards, one GritQL rule each in `plugins/`, each scoped to the code it is about.
  //
  // `no-console.grit` is the logging gate, on each Worker's own `.ts` source, because that is the code that runs in
  // the Worker, where `c.var.log` and `createWorkerLogger()` exist. A `.tsx` file is the client, and a browser
  // console is not a Workers log. A test printing to a terminal is output for a human, not a log line, so tests are
  // out too. `no-process-io.grit` is the same rule for `process.stdout` / `process.stderr`, with the same scope: a
  // build script or a Node CLI of your own writing to stdout is correct, and neither lives under `apps/*/src`.
  //
  // `no-raw-request-input.grit` and `no-bare-zvalidator.grit` keep each route's request contract on the route
  // line, where `pithy contract` reads it. `no-z-config.grit` keeps a locale inside its request, and takes no
  // exclusion, not even for tests.
  //
  // `no-raw-use-effect.grit` keeps effects in hooks named for what they sync with. Each exclusion is one such hook
  // that `pithy ui add` writes, named for the system it syncs with; tests are outside the rule.
  //
  // Yours to change, like every other line here — narrow them, widen them, or drop an entry and delete its plugin
  // file with it. Every plugin file says the same.
  "plugins": [
    {
      "path": "plugins/no-console.grit",
      "includes": ["**/apps/*/src/**/*.ts", "!**/*.test.ts"]
    },
    {
      "path": "plugins/no-process-io.grit",
      "includes": ["**/apps/*/src/**/*.ts", "!**/*.test.ts"]
    },
    {
      "path": "plugins/no-raw-request-input.grit",
      "includes": ["**/apps/*/src/**/*.ts", "!**/*.test.ts"]
    },
    {
      "path": "plugins/no-bare-zvalidator.grit",
      "includes": ["**/apps/*/src/**"]
    },
    {
      "path": "plugins/no-z-config.grit",
      "includes": ["**/apps/*/src/**"]
    },
    {
      "path": "plugins/no-raw-use-effect.grit",
      "includes": [
        "**/apps/*/src/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        // Cloudflare's Turnstile script and its widget iframe.
        "!**/apps/*/src/turnstile.tsx",
        // The Turnstile script and its widget in the React Native web build's page.
        "!**/apps/*/src/useTurnstileWeb.ts",
        // React Native's AppState, for the app coming back to the foreground.
        "!**/apps/*/src/useAppFocus.ts",
        // The platform store's (StoreKit / Play Billing) transaction queue, for the app's whole run.
        "!**/apps/*/src/useStoreTransactions.ts"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
    // Nothing is exempt. `wrangler.jsonc` and `pithy.worker.jsonc` were, because the writer behind
    // `pithy add` and `pithy ui sync` put every array element on its own line and Biome collapses the
    // short ones — so the CLI's own output failed the commit hook the CLI scaffolds (#249). Exempting
    // the two files Pithy touches most from the formatter is not a fix; the writer prints what Biome
    // would print now, and these are ordinary files again.
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": { "level": "on" }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    // Every config Pithy writes is JSONC — wrangler.jsonc, pithy.worker.jsonc, and the tsconfigs.
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
