# deps & build
node_modules/
dist/
.turbo/

# feature worktrees + pithy feature state (scripts/worktree.ts, pithy feature)
.worktrees/
# The port registry moved to <config>/dev-ports.json in #435 and nothing writes this path any more. The
# line stays for the checkouts that still have one: deleting it would make an existing stale file both
# untracked and unignored, which is one `git add -A` away from committing it.
.dev-ports.json
.dev.config.json
.dev-state.json
.pithy-feature.json

# cloudflare / wrangler
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# env & secrets
# No dev secrets line. They live at <config>/<project>/secrets.jsonc, outside every checkout, so there
# is nothing here to ignore — and `.dev.secrets.example.jsonc` is committed documentation. See #156.
.env
.env.*
!.env.example

# atomic-write temp siblings (.dev.vars.<rand>.tmp, …). A write interrupted by SIGINT leaves one
# holding the full plaintext; it must never be committable.
*.tmp

# local-only notes and scratch (never committed)
/.local/

# CLI test scaffolds (removed after each run; crash residue stays out)
.smoke-*/
.e2e-*/
.boot-*/
.migrate-*/
.deploy-it-*/

# editor / os
.DS_Store
*.log
coverage/

# TypeScript build info. Generated by `tsc -b`, never committed.
*.tsbuildinfo

# Release records. Written by `bun scripts/releaseRecords.ts` around `changeset version`, uploaded by
# the release workflow as an artifact, and never committed — the durable record is the CHANGELOGs.
.release/
