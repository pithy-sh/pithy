# env & secrets
.dev.secrets.jsonc
# The atomic write's temp file. `.dev.vars.*` covers its sibling; nothing covered this one, and a
# SIGINT between the write and the rename leaves it behind holding full plaintext.
.dev.secrets.jsonc.tmp
!.dev.secrets.example.jsonc
.env
.env.*
!.env.example

# local-only notes and scratch (never committed)
/.local/

# CLI test scaffolds (removed after each run; crash residue stays out)
.smoke-*/
.e2e-*/
.migrate-*/
.deploy-it-*/

# editor / os
.DS_Store
*.log
coverage/
