{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      // Live Cloudflare — never cached; only packages that define the script run it.
      "dependsOn": ["^build"],
      "cache": false
    },
    "vars:local": {
      // Symlinks each package's .dev.vars to the root file — a filesystem side effect, never cached.
      "cache": false
    },
    "lint": {},
    "clean": {
      "cache": false
    },
    "reset": {
      "cache": false
    }
  }
}
