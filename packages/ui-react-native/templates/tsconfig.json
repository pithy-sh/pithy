{
  // The app's TypeScript: Expo's base, strict. Expo leaves this file as written until you turn on its typed routes;
  // then it adds their entries to `include` and rewrites the file without these comments.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Expo compiles `app.config.ts` itself and hands its imports to Node, which loads a TypeScript file only by its
    // `.ts` extension.
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
