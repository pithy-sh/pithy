{
  "name": "@pithy-sh/payments",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:workers": "vitest run --project=workers",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "peerDependencies": {
    "@pithy-sh/ledger": "workspace:*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pithy-sh/ledger": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@paddle/paddle-js": "^1.6.4",
    "@pithy-sh/core": "workspace:*",
    "@pithy-sh/secrets": "workspace:*",
    "hono": "^4.13.2",
    "kysely": "^0.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@pithy-sh/ledger": "workspace:*",
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.11.1",
    "kysely-d1": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.115.0"
  }
}
