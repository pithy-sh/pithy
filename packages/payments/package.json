{
  "name": "@pithy-sh/payments",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithy-sh/pithy.git",
    "directory": "packages/payments"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./paddle-prices.iife.js": "./dist/paddle-prices.iife.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "pithy.manifest.json",
    "!src/**/*.test.*",
    "!dist/**/*.test.*",
    "!src/client/paddlePrices.iife.ts"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && bun scripts/buildPaddlePrices.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:workers": "vitest run --project=workers",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "peerDependencies": {
    "@pithy-sh/ledger": "^0.1.2",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pithy-sh/ledger": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/zod-validator": "^0.9.0",
    "@paddle/paddle-js": "^1.6.4",
    "@pithy-sh/core": "^0.1.2",
    "@pithy-sh/secrets": "^0.1.2",
    "hono": "^4.13.2",
    "kysely": "^0.29.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@pithy-sh/ledger": "workspace:*",
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.11.1",
    "kysely-d1": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.4",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.115.0"
  }
}
