{
  "name": "@pithy-sh/rating",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithy-sh/pithy.git",
    "directory": "packages/rating"
  },
  "files": [
    "dist",
    "src",
    "pithy.manifest.json",
    "docs",
    "!src/**/*.test.*",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:workers": "vitest run --project=workers",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/zod-validator": "^0.9.0",
    "@pithy-sh/core": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "hono": "^4.13.2",
    "kysely": "^0.29.0",
    "kysely-d1": "^0.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.115.0",
    "zod": "^4.4.0"
  },
  "peerDependencies": {
    "hono": "^4.13.2",
    "kysely": "^0.29.0",
    "zod": "^4.4.0"
  }
}
