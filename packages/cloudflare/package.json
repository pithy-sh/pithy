{
  "name": "@pithy-sh/cloudflare",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "vars:local": "ln -sf ../../.dev.vars .dev.vars",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@pithy-sh/core": "workspace:*",
    "cloudflare": "^5.2.0",
    "js-base64": "^3.7.0",
    "kysely": "^0.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "kysely-d1": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
