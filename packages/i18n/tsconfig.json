{
  "extends": "@pithy-sh/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  // The Worker program. `src/browser/**` and `src/react/**` touch `window` and `document` and compile under
  // `tsconfig.browser.json`; `src/native/**` imports React Native and compiles under `tsconfig.native.json`. Neither
  // set of globals may resolve from the middleware.
  "include": ["src/**/*.ts"],
  "exclude": ["src/browser/**", "src/react/**", "src/native/**"]
}
