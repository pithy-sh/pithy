{
  "extends": "@pithy-sh/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The browser half: the DOM library, and no Workers or Node globals. A module here may import from
    // the Worker program (the config schema, the pure resolver) — never the other way round.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/browser/**/*.ts", "src/react/**/*.ts", "src/react/**/*.tsx"]
}
