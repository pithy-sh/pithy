{
  "name": "@pithy-sh/audit",
  "version": "0.0.0",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "vars:local": "ln -sf ../../.dev.vars .dev.vars",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@pithy-sh/cloudflare": "workspace:*",
    "@pithy-sh/core": "workspace:*",
    "hono": "^4.12.0",
    "kysely": "^0.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@cloudflare/workers-types": "^4.20260610.1",
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "kysely-d1": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.99.0"
  }
}
