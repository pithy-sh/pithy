{
  "name": "@pithy-sh/core",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@pithy-sh/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
