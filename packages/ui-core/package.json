{
  "name": "@pithy-sh/ui-core",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithy-sh/pithy.git",
    "directory": "packages/ui-core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && bun ../../tooling/build/src/stampDeclarations.ts",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.dom.json",
    "test": "vitest run",
    "test:node": "vitest run --project=node --project=dom",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pithy-sh/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
