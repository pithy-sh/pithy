{
  "name": "@pithy-sh/cli",
  "version": "0.17.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithy-sh/pithy.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "pithy": "./dist/bin.js"
  },
  "exports": {
    "./src/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "templates",
    "!src/**/*.test.*",
    "!dist/**/*.test.*",
    "!src/openapi/kitDocument.ts",
    "!src/openapi/writeKitDocument.ts",
    "!src/ci/commentHistory.ts"
  ],
  "scripts": {
    "prepack": "bun scripts/vendorTemplate.ts",
    "postpack": "bun scripts/vendorTemplate.ts --clean",
    "pack:verify": "bun scripts/verifyPack.ts",
    "build": "tsdown && tsc -p tsconfig.build.json && bun ../../tooling/build/src/stampDeclarations.ts",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.contract.json && bun check -p scripts/tsconfig.json && bun check -p tsconfig.ciScripts.json",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:windows": "vitest run --config vitest.windows.config.ts",
    "clean": "rm -rf dist .turbo",
    "reset": "bun run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pithy-sh/cloudflare": "^0.7.1",
    "@pithy-sh/core": "^0.13.0",
    "@pithy-sh/email": "^0.7.0",
    "@pithy-sh/secrets": "^0.6.1",
    "@pithy-sh/turnstile": "^0.6.1",
    "@pithy-sh/ui-react": "^0.5.0",
    "citty": "^0.2.2",
    "comment-json": "^5.0.0",
    "ink": "7.1.1",
    "miniflare": "5.20261012.0-beta",
    "picocolors": "^1.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@pithy-sh/artifacts": "workspace:*",
    "@pithy-sh/audit": "workspace:*",
    "@pithy-sh/auth": "workspace:*",
    "@pithy-sh/i18n": "workspace:*",
    "@pithy-sh/leaderboard": "workspace:*",
    "@pithy-sh/ledger": "workspace:*",
    "@pithy-sh/matchmaking": "workspace:*",
    "@pithy-sh/media": "workspace:*",
    "@pithy-sh/multiplayer": "workspace:*",
    "@pithy-sh/organization": "workspace:*",
    "@pithy-sh/payments": "workspace:*",
    "@pithy-sh/rating": "workspace:*",
    "@pithy-sh/storage": "workspace:*",
    "@pithy-sh/support": "workspace:*",
    "@pithy-sh/testers": "workspace:*",
    "@pithy-sh/tsconfig": "workspace:*",
    "@pithy-sh/vector": "workspace:*",
    "@pithy-sh/vite": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.0",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "4.0.0",
    "kysely": "^0.29.0",
    "rolldown": "^1.2.4",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0",
    "zod": "^4.4.0"
  },
  "peerDependencies": {
    "kysely": "^0.29.0",
    "zod": "^4.4.0"
  }
}
