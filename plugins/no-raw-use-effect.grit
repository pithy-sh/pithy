// Scoped by biome.jsonc to the kit's React sources: packages/*/src/** and packages/ui-react/templates/**.
//
// An effect syncs a component with something outside React. A read is not that, a call a person makes is not
// that, and going somewhere because of an answer is not that, so each has its own tool: `useRead` and
// `useAction` from `@pithy-sh/ui-react/src/read` and `src/action`, and the router's `<Redirect>`. An effect that
// really does sync with an outside system lives in a hook named for it, in its own file, and biome.jsonc excludes
// that file with the system it syncs with beside it.
language js

or {
  `useEffect($...)`,
  `useLayoutEffect($...)`,
  `$_.useEffect($...)`,
  `$_.useLayoutEffect($...)`
} as $call where {
  register_diagnostic(span=$call, message="A raw effect. Load data with useRead, run a call with useAction, navigate on an answer by rendering <Redirect>. An effect that syncs with something outside React goes in a hook named for it, in its own file, excluded in biome.jsonc.")
}
