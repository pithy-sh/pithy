{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Pithy",
    "version": "0.13.1",
    "description": "Every socket the Pithy kit serves, each tagged with the capability that serves it, with the frames each side sends and the built-in games' action and view schemas. A Worker serves the sockets of the capabilities it composes; `pithy contract` writes that Worker's own document. Generated by packages/cli/src/openapi/writeKitDocument.ts. Do not edit by hand; run `bun run kit-contract`."
  },
  "channels": {
    "multiplayerSession": {
      "address": "/multiplayer/sessions/{id}/socket",
      "summary": "Play a session live: the caller's view on every change, and actions as frames.",
      "description": "Only a member of the session may connect. Offer `pithy.multiplayer.v1` in `Sec-WebSocket-Protocol` to receive typed frames; a client that offers no subprotocol is sent the unversioned `snapshot` frame — the bare view, with no `type` — in place of `state`. An offer of anything else is refused with a 400 before the upgrade. A frame's `state` is the game's `<gameKey>.view` and an `action` frame's `payload` is its `<gameKey>.action`, where the game declares them. A client ignores a `type` and a key it does not know.",
      "parameters": {
        "id": {
          "description": "The session's Durable Object id. Bounded, not parsed: a real id is 64 hex characters, but the id a client sent is judged by `idFromString`, which answers an unparseable one with a 404. A hex regex here would make that a 400 and leave the handler's catch unreachable."
        }
      },
      "messages": {
        "multiplayerSession.send.state": {
          "$ref": "#/components/messages/multiplayerSession.send.state"
        },
        "multiplayerSession.send.error": {
          "$ref": "#/components/messages/multiplayerSession.send.error"
        },
        "multiplayerSession.send.snapshot": {
          "$ref": "#/components/messages/multiplayerSession.send.snapshot"
        },
        "multiplayerSession.receive.action": {
          "$ref": "#/components/messages/multiplayerSession.receive.action"
        },
        "multiplayerSession.receive.state": {
          "$ref": "#/components/messages/multiplayerSession.receive.state"
        }
      },
      "tags": [
        {
          "name": "multiplayer"
        }
      ],
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "x-pithy-verification": [
        "bearer",
        "session"
      ],
      "x-pithy-subprotocols": {
        "current": "pithy.multiplayer.v1",
        "previous": null
      }
    },
    "matchmakingPresence": {
      "address": "/matchmaking/presence",
      "summary": "A player's presence: pending invites on connect, then invites, friend requests and matches as they happen.",
      "description": "The Worker sends `init` first, then events as they happen. Send `ping` as plain text to get `pong`. On `pithy.presence.v1`, anything else is answered with an `error` frame; an unversioned socket ignores it.",
      "messages": {
        "matchmakingPresence.send.init": {
          "$ref": "#/components/messages/matchmakingPresence.send.init"
        },
        "matchmakingPresence.send.match_found": {
          "$ref": "#/components/messages/matchmakingPresence.send.match_found"
        },
        "matchmakingPresence.send.invite": {
