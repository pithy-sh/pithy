                      ]
                    },
                    "draw": {
                      "type": "boolean",
                      "description": "Whether the session ended level."
                    },
                    "resolvedAt": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "When the session reached its terminal state, ms-epoch."
                    }
                  },
                  "required": [
                    "status",
                    "scores",
                    "winnerUserId",
                    "draw",
                    "resolvedAt"
                  ],
                  "description": "The resolved outcome of a terminal session."
                },
                {
                  "type": "null"
                }
              ],
              "description": "The result, present only once the session is terminal."
            },
            "state": {
              "description": "The model-specific view for this viewer, redacted by the game's model."
            },
            "fairness": {
              "type": "object",
              "properties": {
                "seedHash": {
                  "type": "string",
                  "description": "The RNG seed's SHA-256 commitment — shown from the start, so a player can verify fairness later."
                },
                "seed": {
                  "description": "The RNG seed itself — null until the session is terminal, then revealed to verify every draw.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "seedHash",
                "seed"
              ],
              "description": "The provably-fair commitment (and, once terminal, the reveal) for this session's randomness."
            }
          },
          "required": [
            "sessionId",
            "gameKey",
            "kind",
            "phase",
            "players",
            "outcome",
            "state",
            "fairness"
          ],
          "description": "One player's view of a session — the game-agnostic envelope around a model-specific, redacted state."
        }
      },
      "multiplayerSession.receive.action": {
        "name": "action",
        "summary": "Take an action in the game.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "action",
              "description": "Always `action`."
            },
            "payload": {
              "description": "The action itself, in the shape the game's model defines — its `<gameKey>.action` schema. Parsed with that schema before the move is judged. Absent reaches the game as no payload."
            }
          },
          "required": [
            "type"
          ],
          "description": "Take an action in the game. Answered by a `state` frame to every member, or an `error` frame."
        }
      },
      "multiplayerSession.receive.state": {
        "name": "state",
        "summary": "Ask for the caller's view again.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "state",
              "description": "Always `state`."
            }
          },
          "required": [
            "type"
          ],
          "description": "Ask for the caller's view again, to resync. Answered by a `state` frame."
        }
      },
      "matchmakingPresence.send.init": {
        "name": "init",
        "summary": "The player's pending invites and online friends, sent once on connect.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "init",
              "description": "Always `init`."
            },
            "pendingInvites": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The invite's UUID, the id the accept and decline routes take."
                  },
                  "gameKey": {
                    "type": "string",
                    "description": "The matchmaking game the invite is for."
                  },
                  "inviterId": {
                    "type": "string",
                    "description": "The user who sent the invite."
                  },
                  "inviteeId": {
                    "type": "string",
                    "description": "The user the invite was sent to."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "accepted",
                      "declined"
                    ],
                    "description": "The invite's current state."
                  },
                  "sessionId": {
                    "description": "The multiplayer session minted when the invite was accepted, or null while pending or declined.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When the invite was sent, ISO-8601."
                  },
                  "respondedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "When the invitee accepted or declined, ISO-8601, or null while pending."
                  }
                },
                "required": [
                  "id",
                  "gameKey",
                  "inviterId",
                  "inviteeId",
                  "status",
                  "sessionId",
                  "createdAt",
                  "respondedAt"
                ],
                "description": "One direct invite from one player to another."
              },
              "description": "The invites waiting on this player, newest first. The same view `GET /invites` returns."
            },
            "onlineFriends": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The user ids of this player's accepted friends who hold a presence socket right now."
            }
          },
          "required": [
            "type",
            "pendingInvites",
            "onlineFriends"
          ],
          "description": "What the Worker sends once, as soon as the socket opens."
        }
      },
      "matchmakingPresence.send.match_found": {
        "name": "match_found",
        "summary": "A match formed around the player.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "match_found",
              "description": "Always `match_found`."
            },
            "sessionId": {
              "type": "string",
              "description": "The multiplayer session the player was seated into."
