  "components": {
    "messages": {
      "multiplayerSession.send.state": {
        "name": "state",
        "summary": "The caller's view of the session, on connect and after every change.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "description": "The session id."
            },
            "gameKey": {
              "type": "string",
              "description": "The game being played."
            },
            "kind": {
              "type": "string",
              "description": "The game model this session uses."
            },
            "phase": {
              "type": "string",
              "enum": [
                "open",
                "active",
                "resolved",
                "abandoned"
              ],
              "description": "The session's current phase."
            },
            "players": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every member's user id, in join order."
            },
            "outcome": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "resolved",
                        "abandoned"
                      ],
                      "description": "The terminal state."
                    },
                    "scores": {
                      "anyOf": [
                        {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Each player's score, or null when abandoned."
                    },
                    "winnerUserId": {
                      "description": "The winner's user id, or null on a draw or abandonment.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "draw": {
                      "type": "boolean",
                      "description": "Whether the session ended level."
                    },
                    "resolvedAt": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "description": "When the session reached its terminal state, ms-epoch."
                    }
                  },
                  "required": [
                    "status",
                    "scores",
                    "winnerUserId",
                    "draw",
                    "resolvedAt"
                  ],
                  "description": "The resolved outcome of a terminal session."
                },
                {
                  "type": "null"
                }
              ],
              "description": "The result, present only once the session is terminal."
            },
            "state": {
              "description": "The model-specific view for this viewer, redacted by the game's model."
            },
            "fairness": {
              "type": "object",
              "properties": {
                "seedHash": {
                  "type": "string",
                  "description": "The RNG seed's SHA-256 commitment — shown from the start, so a player can verify fairness later."
                },
                "seed": {
                  "description": "The RNG seed itself — null until the session is terminal, then revealed to verify every draw.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "seedHash",
                "seed"
              ],
              "description": "The provably-fair commitment (and, once terminal, the reveal) for this session's randomness."
            },
            "type": {
              "type": "string",
              "const": "state",
              "description": "Always `state`."
            }
          },
          "required": [
            "sessionId",
            "gameKey",
            "kind",
            "phase",
            "players",
            "outcome",
            "state",
            "fairness",
            "type"
          ],
          "description": "The caller's view of the session. Sent on connect, after every change to the session, and in answer to a `state` frame."
        }
      },
      "multiplayerSession.send.error": {
        "name": "error",
        "summary": "A refused or failed frame. The socket stays open.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "error",
              "description": "Always `error`."
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Namespaced `domain/reason`, e.g. `auth/invalid_token`. Stable: a client switches on it. The full list is `pithy schema --json`'s `errorCodes`."
                },
                "status": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "The HTTP status, repeated in the body."
                },
                "message": {
                  "type": "string",
                  "description": "English, for a person. A client that translates renders its own wording for `code` instead."
                },
                "params": {
                  "description": "Values a translating client interpolates into its own wording for `code`.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "issues": {
                  "description": "For `validation/invalid_input`: one entry per field that failed, with its path.",
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "code",
                "status",
                "message"
              ],
              "description": "The public error payload. Never carries the operator's remedy or internal detail."
            }
          },
          "required": [
            "type",
            "error"
          ],
          "description": "A refusal or failure, as the same public error payload an HTTP error body carries. The socket stays open."
        }
      },
