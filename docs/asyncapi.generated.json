        },
        "matchmakingPresence.send.friend_request": {
          "$ref": "#/components/messages/matchmakingPresence.send.friend_request"
        },
        "matchmakingPresence.send.error": {
          "$ref": "#/components/messages/matchmakingPresence.send.error"
        },
        "matchmakingPresence.send.pong": {
          "$ref": "#/components/messages/matchmakingPresence.send.pong"
        },
        "matchmakingPresence.receive.ping": {
          "$ref": "#/components/messages/matchmakingPresence.receive.ping"
        }
      },
      "tags": [
        {
          "name": "matchmaking"
        }
      ],
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "x-pithy-verification": [
        "bearer",
        "session"
      ],
      "x-pithy-subprotocols": {
        "current": "pithy.presence.v1",
        "previous": null
      }
    }
  },
